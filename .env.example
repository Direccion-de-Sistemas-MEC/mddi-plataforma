# Plataforma MDDI — configuración (copiar a /etc/mddi/mddi.env o .env, permisos 600)
NODE_ENV=production
PORT=8080
# Conexión a PostgreSQL
DATABASE_URL=postgres://mddi:CAMBIAR_CLAVE_BD@localhost:5432/mddi
# true si la base administrada exige SSL (RDS, Render, Railway…)
DATABASE_SSL=false
# Clave secreta del servidor (OBLIGATORIA). Generar con:  openssl rand -base64 48
# No cambiarla después: invalidaría todos los códigos de acceso.
MDDI_SECRETO=CAMBIAR_POR_CLAVE_LARGA_ALEATORIA
# Código inicial de Coordinación (solo se usa si no hay usuarios). Cambiarlo luego desde la plataforma.
MDDI_CODIGO_COORDINACION=CAMBIAR-COORD-2026
# Usuarios de demostración (DOC-2G-01, ESP-MAT-01, COR-01). En producción: false
MDDI_USUARIOS_DEMO=false
# Cargar el módulo de ejemplo "Kapi, detective de huellas" (versión anterior). Por defecto: false
MDDI_SEED_EJEMPLO=false
# Cookie con atributo Secure (requiere HTTPS). En producción: true
COOKIE_SECURE=true
# Duración de la sesión en días (se renueva sola mientras se usa)
SESION_DIAS=14
